{
  "gcc": "gcc (Ubuntu 13.3.0-6ubuntu2~24.04.1) 13.3.0",
  "strip": "GNU strip (GNU Binutils for Ubuntu) 2.42",
  "platform": "Linux-7.0.0-31-generic-x86_64-with-glibc2.39",
  "common_cflags": [
    "-std=c11",
    "-fPIC",
    "-shared",
    "-Wall",
    "-Wextra"
  ],
  "configs": {
    "plain": {
      "cflags": [
        "-O0",
        "-g"
      ],
      "strip": false
    },
    "opt": {
      "cflags": [
        "-O2"
      ],
      "strip": true
    },
    "obf": {
      "cflags": [
        "-O2",
        "-DVERA_OBF"
      ],
      "strip": true
    }
  }
}
